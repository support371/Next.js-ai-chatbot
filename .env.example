OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=8080
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=2mb
RATE_LIMIT_PER_MINUTE=60
APP_HEALTH_TIMEOUT_MS=5000

# Legacy comma-separated API keys accepted by the API. Use a vault/secret manager in production.
OPENGUARDIANS_API_KEYS=

# Preferred production format for scoped keys.
# Example:
# OPENGUARDIANS_API_KEY_CONFIG_JSON=[{"name":"admin","key":"replace_me","role":"admin","scopes":["*"],"workspaces":["*"]}]
OPENGUARDIANS_API_KEY_CONFIG_JSON=

DATABASE_URL=
REDIS_URL=

DEFAULT_WORKSPACE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
THREADS_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

APPLICATIONINSIGHTS_CONNECTION_STRING=
